# =============================================================
# Koya Content Agent — Environment Variables
# Copy this file to .env.local for local development
# NEVER commit .env.local or any file containing real secrets
# =============================================================

# ---- Supabase ------------------------------------------------
# Found in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — SERVER ONLY, never expose to browser
# Used only in server-side API routes and migrations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Anthropic Claude ----------------------------------------
# Found at https://console.anthropic.com/
# SERVER ONLY — never set NEXT_PUBLIC_ on this key
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Firecrawl -----------------------------------------------
# Found at https://firecrawl.dev/
# SERVER ONLY
FIRECRAWL_API_KEY=your-firecrawl-api-key

# ---- App Configuration ---------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Koya Content Agent

# Sign-off name used by generated content (newsletters, articles, social posts).
# Set to your brand or author name. If empty/placeholder, no sign-off is added
# and the AI is instructed to never invent or use placeholder names.
CONTENT_AUTHOR_NAME=

# Use 'mock' in development to avoid calling real AI/research APIs
# Use 'real' in production
AI_PROVIDER=mock
RESEARCH_PROVIDER=mock
# ---- Publishing Providers -----------------------------------

# Set PUBLISHING_PROVIDER=real to use real platforms
# Each channel only activates if its credentials are present
# Channels without credentials fall back to mock automatically

PUBLISHING_PROVIDER=mock

# LinkedIn
# Get access token: https://www.linkedin.com/developers/
# Scopes needed: w_member_social
# Get your author URN:
#   curl -H "Authorization: Bearer <token>" https://api.linkedin.com/v2/userinfo
#   Use the "sub" value as: urn:li:person:<sub>
LINKEDIN_ACCESS_TOKEN=placeholder-linkedin-token
LINKEDIN_AUTHOR_URN=urn:li:person:your-person-id

# X (Twitter)
# Get credentials: https://developer.twitter.com/
# App permissions: Read and Write
# Generate Access Token and Secret under Keys and Tokens
TWITTER_API_KEY=placeholder-twitter-api-key
TWITTER_API_SECRET=placeholder-twitter-api-secret
TWITTER_ACCESS_TOKEN=placeholder-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=placeholder-twitter-access-token-secret

# Email Newsletter via Brevo
# Sign up: https://app.brevo.com
# Settings → API Keys → Generate a new API key
# Verify your sending domain under Senders & Domains
BREVO_API_KEY=your-brevo-api-key
NEWSLETTER_FROM=newsletter@yourdomain.com
NEWSLETTER_FROM_NAME=Your Newsletter Name
NEWSLETTER_TO=subscriber@example.com

# ---- Feature Flags -------------------------------------------
# Enforce that reviewers cannot approve their own content
ENFORCE_SEPARATION_OF_DUTIES=true

# Maximum automatic AI revision attempts before requiring human review
MAX_AUTO_REVISIONS=3

# ---- Rate Limiting -------------------------------------------
# Max API requests per minute per user (applied server-side)
API_RATE_LIMIT_PER_MINUTE=60

# ---- Demo Mode -----------------------------------------------
# Set to 'true' to show demo data and mock publishing labels
NEXT_PUBLIC_DEMO_MODE=false
